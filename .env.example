# Settings for the Docker stack. `rack up` copies this to .env the first time.

# Which network interface the web UI and API listen on.
# Keep 127.0.0.1 (this machine only) and use Tailscale for access from your phone/laptop.
BIND_ADDR=127.0.0.1
OPEN_WEBUI_PORT=3000

# How long a model stays in memory after a request (30m, 2h, or -1 for always).
OLLAMA_KEEP_ALIVE=30m
# Default context window in tokens. Bigger uses more memory.
OLLAMA_CONTEXT_LENGTH=8192

# Keeps web UI logins valid across container upgrades. `rack up` fills this in.
WEBUI_SECRET_KEY=

# Optional API gateway (`rack up --gateway`). `rack up` generates a key if this is empty.
RACK_API_KEY=
GATEWAY_PORT=8000
GATEWAY_BIND=127.0.0.1
